{
  "name": "carltontrailcollege/glpi-inject",
  "description": "Reusable CSV imports for standard and custom GLPI assets.",
  "type": "glpi-plugin",
  "license": "GPL-2.0-or-later",
  "require-dev": {
    "friendsoftwig/twigcs": "6.6.1",
    "glpi-project/coding-standard": "0.9.0",
    "phpstan/phpstan": "2.1.56"
  },
  "scripts": {
    "lint:php": "phpcs --standard=vendor/glpi-project/coding-standard/GlpiStandard --extensions=php hook.php setup.php phpstan-bootstrap.php ajax front src scripts/package-release.php",
    "lint:twig": "twigcs templates",
    "lint:js": "npm run lint:inline-js",
    "analyse": "phpstan analyse --configuration=phpstan.neon --memory-limit=1G",
    "test": [
      "@php -d zend.assertions=1 -d assert.exception=1 tests/run.php",
      "@php -d zend.assertions=1 -d assert.exception=1 tests/provider.php"
    ],
    "check": [
      "@lint:php",
      "@lint:twig",
      "@lint:js",
      "@analyse",
      "@test"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}