<div class="page-header mb-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
    <h1 class="mb-0">{{ __('GLPI Inject', 'glpiinject') }}</h1>
    <a class="btn btn-outline-secondary" href="{{ root_doc }}/plugins/glpiinject/front/models.php">{{ __('Model management', 'glpiinject') }}</a>
</div>

{% if error %}
    <div class="alert alert-danger" role="alert">{{ error }}</div>
{% endif %}

{% if import_results and import_results.status != 'running' %}
    <div class="alert {{ import_results.status == 'completed' and (import_results.created + import_results.updated) > 0 and import_results.failed == 0 ? 'alert-success' : 'alert-danger' }}" role="status">
        <strong>{{ import_results.status == 'completed' and (import_results.created + import_results.updated) > 0 and import_results.failed == 0 ? __('Import completed.', 'glpiinject') : __('Import did not complete successfully.', 'glpiinject') }}</strong>
        {{ __('Created', 'glpiinject') }}: {{ import_results.created }} · {{ __('Updated', 'glpiinject') }}: {{ import_results.updated }} · {{ __('Failed', 'glpiinject') }}: {{ import_results.failed }}
        {% set first_failure = import_results.rows|filter(row => row.status == 'failed')|first %}
        {% if first_failure %}<div class="mt-1">{{ __('Line', 'glpiinject') }} {{ first_failure.line }}: {{ first_failure.message }}</div>{% endif %}
    </div>
{% endif %}

<div class="row g-3">
    <main class="col-12">
        <section class="border rounded p-3 mb-3">
            <h2 class="h4">{{ __('Client Injection Configuration', 'glpiinject') }}</h2>
            {% if models is empty %}
                <div class="alert alert-info mb-0">{{ __('No model currently available.', 'glpiinject') }} <a href="{{ root_doc }}/plugins/glpiinject/front/models.php">{{ __('Create an import model', 'glpiinject') }}</a></div>
            {% else %}
                <form method="get" class="row g-2 align-items-end">
                    <div class="col-12 col-lg-8"><label class="form-label" for="model-select">{{ __('Model', 'glpiinject') }}</label><select class="form-select" id="model-select" name="id" required onchange="this.form.requestSubmit();"><option value="">{{ __('Select a model', 'glpiinject') }}</option>{% for entry in models %}<option value="{{ entry.id }}" {{ model and model.id == entry.id ? 'selected' : '' }}>{{ entry.name }}</option>{% endfor %}</select></div>
                    <div class="col-12 col-lg-4 d-flex flex-wrap gap-2"><button class="btn btn-outline-secondary" type="submit" id="edit-selected-model" data-edit-url="{{ root_doc }}/plugins/glpiinject/front/models.php"><i class="ti ti-edit" aria-hidden="true"></i> {{ __('Edit', 'glpiinject') }}</button></div>
                </form>
            {% endif %}
        </section>

        {% if model %}
            <section class="border rounded p-3 mb-3">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                    <div><h2 class="h3 mb-1">{{ model.name }}</h2><div class="text-muted">{{ model.itemtype }}</div></div>
                    {% if model.csv_file %}<div class="text-end"><span class="badge bg-success text-dark fw-semibold px-3 py-2">{{ __('CSV loaded', 'glpiinject') }}</span><div class="small text-muted mt-1">{{ __('Last uploaded', 'glpiinject') }}: {{ model.csv_uploaded_at_display ?? __('Upload time unavailable', 'glpiinject') }}</div></div>{% else %}<span class="badge bg-secondary">{{ __('Waiting for CSV', 'glpiinject') }}</span>{% endif %}
                </div>
                <form method="post" action="{{ root_doc }}/plugins/glpiinject/front/index.php?id={{ model.id }}" enctype="multipart/form-data" class="row g-3 align-items-end">
                    <input type="hidden" name="models_id" value="{{ model.id }}">
                    <input type="hidden" name="action" value="upload_csv">
                    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                    <div class="col-12"><h3 class="h5">{{ __('File to inject', 'glpiinject') }}</h3></div>
                    <div class="col-12 col-lg-6"><label class="form-label" for="csv-file">{{ __('Choose a file', 'glpiinject') }}</label><input class="form-control" id="csv-file" name="csv_file" type="file" accept=".csv,text/csv" required></div>
                    <div class="col-12 col-md-4 col-lg-2"><label class="form-label" for="file-encoding">{{ __('File encoding', 'glpiinject') }}</label><select class="form-select" id="file-encoding" name="file_encoding"><option value="Automatic" {{ model.file_encoding == 'Automatic' ? 'selected' : '' }}>{{ __('Automatic detection', 'glpiinject') }}</option><option value="UTF-8" {{ model.file_encoding == 'UTF-8' ? 'selected' : '' }}>UTF-8</option><option value="ISO-8859-1" {{ model.file_encoding == 'ISO-8859-1' ? 'selected' : '' }}>ISO-8859-1</option><option value="Windows-1252" {{ model.file_encoding == 'Windows-1252' ? 'selected' : '' }}>Windows-1252</option></select></div>
                    <div class="col-12 col-md-4 col-lg-2"><label class="form-label" for="upload-delimiter">{{ __('File delimiter', 'glpiinject') }}</label><select class="form-select" id="upload-delimiter" name="delimiter"><option value=";" {{ model.delimiter == ';' ? 'selected' : '' }}>{{ __('Semicolon', 'glpiinject') }}</option><option value="," {{ model.delimiter == ',' ? 'selected' : '' }}>{{ __('Comma', 'glpiinject') }}</option><option value="|" {{ model.delimiter == '|' ? 'selected' : '' }}>{{ __('Pipe', 'glpiinject') }}</option><option value="&#9;" {{ model.delimiter == "\t" ? 'selected' : '' }}>{{ __('Tab', 'glpiinject') }}</option></select></div>
                    <div class="col-12 col-md-4 col-lg-2"><label class="form-check mb-2"><input class="form-check-input" type="checkbox" name="has_header" value="1" {{ model.has_header ? 'checked' : '' }}><span class="form-check-label">{{ __('First Row is Header', 'glpiinject') }}</span></label></div>
                    <div class="col-12 d-flex flex-wrap gap-2"><button class="btn btn-primary" type="submit">{{ __('Load this file', 'glpiinject') }}</button>{% if preview and not error %}<a class="btn btn-outline-primary" href="#column-mapping">{{ __('Continue', 'glpiinject') }}</a>{% else %}<button class="btn btn-outline-primary" type="button" disabled>{{ __('Continue', 'glpiinject') }}</button>{% endif %}</div>
                </form>
                {% if preview and not error %}<div class="text-success fw-semibold mt-2" role="status"><i class="ti ti-check" aria-hidden="true"></i> {{ __('CSV file loaded successfully.', 'glpiinject') }}</div>{% endif %}
            </section>

            {% if selected_run and selected_run.status == 'running' %}
                <section class="border rounded p-3 mb-3" id="import-progress" data-batch-url="{{ batch_url }}" data-results-url="{{ root_doc }}/plugins/glpiinject/front/index.php?id={{ model.id }}&amp;run={{ selected_run.id }}" data-run-id="{{ selected_run.id }}" data-offset="{{ selected_run.processed }}" data-total="{{ selected_run.total }}" data-csrf-token="{{ csrf_token }}">
                    <div class="hr-text mb-3"><i class="ti ti-chart-bar"></i><span>{{ __('Import progress', 'glpiinject') }}</span></div>
                    <div class="progress" role="progressbar" aria-label="{{ __('Injection of the file', 'glpiinject') }}" aria-valuenow="{{ selected_run.total ? (selected_run.processed / selected_run.total * 100)|round : 0 }}" aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar progress-bar-striped progress-bar-animated {{ selected_run.total ? '' : 'progress-bar-indeterminate' }}" style="width: {{ selected_run.total ? (selected_run.processed / selected_run.total * 100)|round : 30 }}%">{{ selected_run.total ? (selected_run.processed / selected_run.total * 100)|round ~ '%' : '' }}</div>
                    </div>
                    <p class="text-muted text-center mt-2" data-progress-status>{% if selected_run.total %}{{ __('Injection of the file', 'glpiinject') }}: {{ selected_run.processed }} / {{ selected_run.total }} {{ __('lines', 'glpiinject') }}{% else %}{{ __('Processed rows', 'glpiinject') }}: {{ selected_run.processed }}{% endif %}</p>
                    <button class="btn btn-outline-danger" type="button" data-cancel-import><i class="ti ti-player-stop" aria-hidden="true"></i> {{ __('Cancel import', 'glpiinject') }}</button>
                    <div class="alert alert-danger d-none" data-progress-error role="alert"></div>
                </section>
            {% endif %}

            {% if preview %}
                <section class="border rounded p-3 mb-3" id="column-mapping" style="scroll-margin-top: 5rem;">
                    <h2 class="h4">{{ __('Column mapping', 'glpiinject') }}</h2>
                    <form method="post">
                        <input type="hidden" name="models_id" value="{{ model.id }}">
                        <input type="hidden" name="action" value="save_mapping">
                        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                        <div class="row g-3 mb-3">
                            <div class="col-12 col-md-4"><label class="form-label" for="match-field">{{ __('Update matching records by', 'glpiinject') }}</label><select class="form-select" id="match-field" name="match_field" required>{% for field in targets[model.itemtype].fields %}{% if not field.is_custom %}<option value="{{ field.field }}" {{ (model.match_field|default('name', true)) == field.field ? 'selected' : '' }}>{{ field.name }}</option>{% endif %}{% endfor %}</select></div>
                        </div>
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                            <button class="btn btn-outline-secondary" type="button" data-apply-mapping-suggestions>{{ __('Apply suggestions', 'glpiinject') }}</button>
                            <span class="form-text mb-0">{{ __('Suggestions are based on matching CSV headers to available fields. Review them before saving; saved or manually selected mappings are left unchanged.', 'glpiinject') }}</span>
                        </div>
                        <p class="form-text">{{ __('For mapped columns, check Required when every imported row must have a value. Blank values in required columns fail row validation.', 'glpiinject') }}</p>
                        <div class="table-responsive"><table class="table table-striped table-hover align-middle"><thead><tr><th>{{ __('Header of the file', 'glpiinject') }}</th><th>{{ __('Tables', 'glpiinject') }}</th><th>{{ _n('Field', 'Fields', 2) }}</th><th>{{ __('Suggestion', 'glpiinject') }}</th><th>{{ __('Link field', 'glpiinject') }}</th><th>{{ __('Required', 'glpiinject') }}</th></tr></thead><tbody>
                            {% for header in preview.headers %}
                                {% set column_index = loop.index0 %}
                                {% set saved_mapping = model.mappings[column_index] ?? {} %}
                                {% set selected_option = null %}
                                {% for option in targets[model.itemtype].mapping_options %}
                                    {% if saved_mapping.itemtype is defined and saved_mapping.itemtype == option.itemtype and saved_mapping.field == option.field and saved_mapping.linkfield == option.linkfield %}
                                        {% set selected_option = option %}
                                    {% endif %}
                                    {% if saved_mapping is not iterable and saved_mapping == option.field %}
                                        {% set selected_option = option %}
                                    {% endif %}
                                {% endfor %}
                                {% set mapping_suggestion = mapping_suggestions[column_index] ?? {status: 'unmatched', label: '', option_index: null} %}
                                <tr>
                                    <th scope="row">{{ header }}</th>
                                    <td class="mapping-type" data-column="{{ column_index }}">{{ selected_option.itemtype_label ?? __('Choose a table', 'glpiinject') }}</td>
                                    <td>
                                        <select class="form-select mapping-option" data-column="{{ column_index }}" data-saved-mapping="{{ selected_option ? '1' : '0' }}" name="mapping[{{ column_index }}][option]">
                                            <option value="">{{ __('Do not import', 'glpiinject') }}</option>
                                            {% for option in targets[model.itemtype].mapping_options %}
                                                {% set option_index = loop.index0 %}
                                                <option value="{{ option_index }}" data-type="{{ option.itemtype_label }}" data-field="{{ option.field }}" data-linkfield="{{ option.linkfield }}" {{ selected_option and selected_option.itemtype == option.itemtype and selected_option.field == option.field and selected_option.linkfield == option.linkfield ? 'selected' : '' }}>{{ option.label }}</option>
                                            {% endfor %}
                                        </select>
                                    </td>
                                    <td>
                                        {% if mapping_suggestion.status == 'saved' %}<span class="text-muted">{{ __('Saved mapping', 'glpiinject') }}</span>
                                        {% elseif mapping_suggestion.status == 'suggested' %}<span class="text-success">{{ __('Suggested', 'glpiinject') }}: {{ mapping_suggestion.label }}</span>
                                        {% elseif mapping_suggestion.status == 'ambiguous' %}<span class="text-warning">{{ __('Close matches; choose manually', 'glpiinject') }}{% if mapping_suggestion.candidate_labels is not empty %}: {{ mapping_suggestion.candidate_labels|join(', ') }}{% endif %}</span>
                                        {% else %}<span class="text-muted">{{ __('No match found', 'glpiinject') }}</span>{% endif %}
                                        <input type="hidden" data-suggestion-status="{{ mapping_suggestion.status }}" data-suggestion-option="{{ mapping_suggestion.option_index is not null ? mapping_suggestion.option_index : '' }}">
                                    </td>
                                    <td><code class="mapping-linkfield" data-column="{{ column_index }}">{{ selected_option.linkfield ?? '—' }}</code></td>
                                    <td class="text-center"><input class="form-check-input" type="checkbox" name="mapping[{{ column_index }}][is_mandatory]" value="1" {{ saved_mapping.is_mandatory ?? false ? 'checked' : '' }} aria-label="{{ __('Require a CSV value for', 'glpiinject') }} {{ header }}"></td>
                                </tr>
                            {% endfor %}
                        </tbody></table></div>
                        <div class="d-flex flex-wrap align-items-center gap-3">
                            <button class="btn btn-primary" type="submit">{{ __('Save mapping', 'glpiinject') }}</button>
                            {% if mapping_saved %}<span class="text-success fw-semibold" role="status" aria-live="polite"><i class="ti ti-check" aria-hidden="true"></i> {{ __('Saved successfully.', 'glpiinject') }}</span>{% endif %}
                        </div>
                    </form>
                </section>

                <section class="border rounded p-3 mb-3" id="preview-section" style="scroll-margin-top: 5rem;">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                        <h2 class="h4 mb-0">{{ __('Preview', 'glpiinject') }}</h2>
                        <form method="post" class="d-flex flex-wrap align-items-center gap-2">
                            <input type="hidden" name="models_id" value="{{ model.id }}">
                            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                            <label class="form-label mb-0" for="preview-size">{{ __('Result Size', 'glpiinject') }}</label>
                            <select class="form-select w-auto" id="preview-size" name="preview_size" onchange="this.form.requestSubmit(this.form.querySelector('[value=preview]'));">
                                {% for size in preview_sizes %}<option value="{{ size }}" {{ preview_size == size ? 'selected' : '' }}>{{ size }}</option>{% endfor %}
                            </select>
                            <div class="dropdown" id="preview-columns" data-model-id="{{ model.id }}">
                                <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false"><i class="ti ti-columns" aria-hidden="true"></i> {{ __('Columns', 'glpiinject') }}</button>
                                <div class="dropdown-menu dropdown-menu-end p-3" style="min-width: 16rem; max-width: min(24rem, 90vw); max-height: 24rem; overflow-y: auto;">
                                    <div class="d-flex flex-wrap gap-2 mb-2"><button class="btn btn-sm btn-outline-secondary" type="button" data-preview-columns-all>{{ __('Show all', 'glpiinject') }}</button><button class="btn btn-sm btn-outline-secondary" type="button" data-preview-columns-none>{{ __('Hide all', 'glpiinject') }}</button></div>
                                    {% for header in preview.headers %}
                                        <label class="form-check mb-2"><input class="form-check-input" type="checkbox" value="{{ loop.index0 }}" data-preview-column-toggle checked><span class="form-check-label text-break">{{ header }}</span></label>
                                    {% endfor %}
                                </div>
                            </div>
                            <button class="btn btn-outline-secondary" name="action" value="preview" type="submit">{{ __('Refresh preview', 'glpiinject') }}</button>
                            <button class="btn btn-success" name="action" value="run_import" type="submit" onclick="return window.confirm({{ __('Watch out, you are about to inject data into GLPI. Are you sure you want to do it?', 'glpiinject')|json_encode }});" {{ model.mappings is empty ? 'disabled' : '' }}>{{ __('Launch the import', 'glpiinject') }}</button>
                        </form>
                    </div>
                    <div class="table-responsive preview-table-scroll" tabindex="0" role="region" aria-label="{{ __('CSV preview data', 'glpiinject') }}"><table class="table table-sm table-striped" id="preview-table"><thead><tr><th scope="col">{{ __('Validation', 'glpiinject') }}</th><th scope="col">{{ __('Line', 'glpiinject') }}</th>{% for header in preview.headers %}<th data-preview-column="{{ loop.index0 }}">{{ header }}</th>{% endfor %}</tr></thead><tbody>
                        {% for record in preview.records %}<tr><td class="preview-validation-cell">{% if record.valid %}<span class="badge bg-success text-wrap">{{ __('Valid', 'glpiinject') }}</span>{% else %}<span class="badge bg-danger text-wrap">{{ record.errors|join('; ') }}</span>{% endif %}</td><th scope="row">{{ record.line }}</th>{% for header in preview.headers %}<td data-preview-column="{{ loop.index0 }}" aria-label="{{ header }}">{{ record.values[loop.index0] ?? '' }}</td>{% endfor %}</tr>{% else %}<tr><td colspan="{{ preview.headers|length + 2 }}" class="text-muted">{{ __('No data rows found.', 'glpiinject') }}</td></tr>{% endfor %}
                    </tbody></table></div>
                </section>
            {% endif %}

            {% if import_results and import_results.status == 'cancelled' %}
                <section class="border rounded p-3">
                    <div class="hr-text mb-3"><i class="ti ti-player-stop text-warning"></i><span>{{ __('Import cancelled', 'glpiinject') }}</span></div>
                    <p class="text-center">{{ __('Processed', 'glpiinject') }}: {{ import_results.processed }} · {{ __('Created', 'glpiinject') }}: {{ import_results.created }} · {{ __('Updated', 'glpiinject') }}: {{ import_results.updated }} · {{ __('Failed', 'glpiinject') }}: {{ import_results.failed }}</p>
                    <a class="btn btn-primary" href="{{ root_doc }}/plugins/glpiinject/front/index.php">{{ __('Finish', 'glpiinject') }}</a>
                </section>
            {% elseif import_results and import_results.status != 'running' %}
                <section class="border rounded p-3" id="import-results" style="scroll-margin-top: 5rem;"><div class="hr-text mb-3"><i class="ti ti-chart-bar"></i><span>{{ __('Injection results', 'glpiinject') }}</span></div><p class="text-center fs-5">{% if import_results.status == 'failed' or import_results.failed > 0 %}<i class="ti ti-alert-triangle text-danger"></i> {{ __('Import failed or completed with errors.', 'glpiinject') }}{% elseif import_results.created + import_results.updated == 0 %}<i class="ti ti-alert-circle text-warning"></i> {{ __('No assets were created or updated.', 'glpiinject') }}{% else %}<i class="ti ti-check text-success"></i> {{ __('Injection successful', 'glpiinject') }}{% endif %}</p><p class="text-center">{{ __('Status', 'glpiinject') }}: {{ import_results.status }} · {{ __('Processed', 'glpiinject') }}: {{ import_results.processed }} / {{ import_results.total }}</p><p class="text-center">{{ __('Created', 'glpiinject') }}: {{ import_results.created }} · {{ __('Updated', 'glpiinject') }}: {{ import_results.updated }} · {{ __('Failed', 'glpiinject') }}: {{ import_results.failed }}</p><div class="table-responsive"><table class="table table-sm"><thead><tr><th>{{ __('Line', 'glpiinject') }}</th><th>{{ __('Result', 'glpiinject') }}</th><th>{{ __('Details', 'glpiinject') }}</th></tr></thead><tbody>{% for row in import_results.rows %}<tr><td>{{ row.line }}</td><td>{{ row.status }}</td><td>{{ row.message ?? '' }}</td></tr>{% endfor %}</tbody></table></div><div class="d-flex justify-content-center gap-2">{% if import_results.failed > 0 and selected_run %}<a class="btn btn-outline-danger" href="{{ root_doc }}/plugins/glpiinject/front/export_errors.php?run={{ selected_run.id }}"><i class="ti ti-file-type-csv"></i> {{ __('Export the log', 'glpiinject') }}</a>{% endif %}<a class="btn btn-primary" href="{{ root_doc }}/plugins/glpiinject/front/index.php">{{ __('Finish', 'glpiinject') }}</a></div></section>
            {% endif %}
        {% else %}
            <div class="border rounded p-4 text-center text-muted">{{ __('Select an import model or create one to get started.', 'glpiinject') }}</div>
        {% endif %}
    </main>
</div>

<script>
const previewColumns = document.getElementById('preview-columns');
if (previewColumns) {
    const toggles = Array.from(previewColumns.querySelectorAll('[data-preview-column-toggle]'));
    const headers = Array.from(document.querySelectorAll('#preview-table thead [data-preview-column]'), (header) => header.textContent);
    const storageKey = `glpiinject-preview-columns:${window.location.pathname}:${previewColumns.dataset.modelId}`;
    const columnStyle = document.createElement('style');
    document.head.appendChild(columnStyle);
    const resizeStyle = document.createElement('style');
    resizeStyle.textContent = '.preview-table-scroll { max-width: 100%; overflow-x: auto; } #preview-table { width: max-content; min-width: 100%; table-layout: fixed; } #preview-table th, #preview-table td { overflow-wrap: anywhere; } #preview-table thead th { position: relative; padding-inline-end: 1.25rem; } #preview-table th:first-child, #preview-table td:first-child { position: sticky; inset-inline-start: 0; z-index: 10; min-width: 220px; max-width: 280px; white-space: normal; background: var(--bs-body-bg, #fff) !important; box-shadow: none; } #preview-table thead th:first-child { z-index: 11; } .preview-column-resizer { position: absolute; inset-block: 0; inset-inline-end: 0; width: 12px; cursor: col-resize; touch-action: none; user-select: none; } .preview-column-resizer::after { content: ""; position: absolute; inset-block: 25%; inset-inline-start: 5px; border-inline-start: 2px solid var(--bs-border-color); } .preview-column-resizer:focus-visible { outline: 2px solid var(--bs-primary); outline-offset: -2px; }';
    document.head.appendChild(resizeStyle);
    const previewTable = document.getElementById('preview-table');
    const previewHeaders = Array.from(previewTable.querySelectorAll('thead th'));
    const previewHeaderLabels = previewHeaders.map((header) => header.textContent.trim());
    const resizeStorageKey = `glpiinject-preview-widths:${window.location.pathname}:${previewColumns.dataset.modelId}`;
    const columnGroup = document.createElement('colgroup');
    const columnElements = previewHeaders.map(() => document.createElement('col'));
    columnElements.forEach((column) => columnGroup.appendChild(column));
    previewTable.insertBefore(columnGroup, previewTable.firstChild);
    const setColumnWidth = (index, width) => {
        const normalizedWidth = Math.max(index === 0 ? 220 : 72, Math.round(width));
        columnElements[index].style.width = `${normalizedWidth}px`;
        previewHeaders[index].querySelector('.preview-column-resizer').setAttribute('aria-valuenow', String(normalizedWidth));
    };
    const saveColumnWidths = () => {
        try {
            sessionStorage.setItem(resizeStorageKey, JSON.stringify({headers: previewHeaderLabels, widths: columnElements.map((column) => Number.parseFloat(column.style.width))}));
        } catch (_) {}
    };
    let savedWidths = null;
    try {
        savedWidths = JSON.parse(sessionStorage.getItem(resizeStorageKey));
    } catch (_) {}
    const widthsMatch = savedWidths
        && JSON.stringify(savedWidths.headers) === JSON.stringify(previewHeaderLabels)
        && Array.isArray(savedWidths.widths)
        && savedWidths.widths.length === columnElements.length;
    previewHeaders.forEach((header, index) => {
        const initialWidth = widthsMatch && Number.isFinite(savedWidths.widths[index])
            ? savedWidths.widths[index]
            : index === 0 ? 240 : index === 1 ? 72 : Math.min(320, Math.max(140, header.scrollWidth + 16));
        const resizer = document.createElement('span');
        resizer.className = 'preview-column-resizer';
        resizer.setAttribute('role', 'separator');
        resizer.setAttribute('aria-orientation', 'vertical');
        resizer.setAttribute('aria-label', `{{ __('Resize column', 'glpiinject')|e('js') }}: ${previewHeaderLabels[index]}`);
        resizer.setAttribute('aria-valuemin', '72');
        resizer.setAttribute('aria-valuenow', String(initialWidth));
        resizer.tabIndex = 0;
        header.appendChild(resizer);
        setColumnWidth(index, initialWidth);
        let dragStartX = 0;
        let dragStartWidth = 0;
        resizer.addEventListener('pointerdown', (event) => {
            if (event.button !== 0) return;
            event.preventDefault();
            dragStartX = event.clientX;
            dragStartWidth = columnElements[index].getBoundingClientRect().width;
            resizer.setPointerCapture(event.pointerId);
        });
        resizer.addEventListener('pointermove', (event) => {
            if (!resizer.hasPointerCapture(event.pointerId)) return;
            setColumnWidth(index, dragStartWidth + event.clientX - dragStartX);
        });
        const finishResize = (event) => {
            if (!resizer.hasPointerCapture(event.pointerId)) return;
            resizer.releasePointerCapture(event.pointerId);
            saveColumnWidths();
        };
        resizer.addEventListener('pointerup', finishResize);
        resizer.addEventListener('pointercancel', finishResize);
        resizer.addEventListener('keydown', (event) => {
            if (!['ArrowLeft', 'ArrowRight'].includes(event.key)) return;
            event.preventDefault();
            const direction = event.key === 'ArrowRight' ? 1 : -1;
            const step = event.shiftKey ? 40 : 10;
            setColumnWidth(index, columnElements[index].getBoundingClientRect().width + direction * step);
            saveColumnWidths();
        });
    });
    try {
        const saved = JSON.parse(sessionStorage.getItem(storageKey));
        if (saved && JSON.stringify(saved.headers) === JSON.stringify(headers) && Array.isArray(saved.hidden)) {
            toggles.forEach((toggle) => { toggle.checked = !saved.hidden.includes(Number(toggle.value)); });
        }
    } catch (_) {}
    const updatePreviewColumns = () => {
        const hidden = toggles.filter((toggle) => !toggle.checked).map((toggle) => Number(toggle.value));
        columnStyle.textContent = hidden.map((column) => `#preview-table [data-preview-column="${column}"], #preview-table col:nth-child(${column + 3}) { display: none; }`).join('\n');
        try {
            sessionStorage.setItem(storageKey, JSON.stringify({headers, hidden}));
        } catch (_) {}
    };
    previewColumns.addEventListener('change', updatePreviewColumns);
    previewColumns.querySelector('[data-preview-columns-all]').addEventListener('click', () => {
        toggles.forEach((toggle) => { toggle.checked = true; });
        updatePreviewColumns();
    });
    previewColumns.querySelector('[data-preview-columns-none]').addEventListener('click', () => {
        toggles.forEach((toggle) => { toggle.checked = false; });
        updatePreviewColumns();
    });
    updatePreviewColumns();
}

const modelSelect = document.getElementById('model-select');
const editSelectedModel = document.getElementById('edit-selected-model');
modelSelect?.form.addEventListener('submit', (event) => {
    if (event.submitter !== editSelectedModel) return;
    event.preventDefault();
    const editUrl = new URL(editSelectedModel.dataset.editUrl, window.location.href);
    editUrl.searchParams.set('edit', modelSelect.value);
    window.location.assign(editUrl.href);
});

document.querySelectorAll('.mapping-option').forEach((select) => {
    select.addEventListener('change', () => {
        const selected = select.selectedOptions[0];
        const column = select.dataset.column;
        document.querySelector(`.mapping-type[data-column="${column}"]`).textContent = selected.dataset.type || '{{ __('Choose a table', 'glpiinject')|e('js') }}';
        document.querySelector(`.mapping-linkfield[data-column="${column}"]`).textContent = selected.dataset.linkfield || '—';
    });
});

document.querySelector('[data-apply-mapping-suggestions]')?.addEventListener('click', () => {
    document.querySelectorAll('.mapping-option').forEach((select) => {
        if (select.dataset.savedMapping === '1' || select.value !== '') return;
        const suggestion = select.closest('tr').querySelector('[data-suggestion-status]');
        if (suggestion.dataset.suggestionStatus !== 'suggested') return;
        select.value = suggestion.dataset.suggestionOption;
        select.dispatchEvent(new Event('change', {bubbles: true}));
    });
});

{% if scroll_to_preview %}
document.getElementById('preview-section')?.scrollIntoView({behavior: 'smooth', block: 'start'});
{% elseif selected_run and selected_run.status == 'running' %}
document.getElementById('import-progress')?.scrollIntoView({behavior: 'smooth', block: 'start'});
{% elseif import_results and import_results.status != 'running' %}
document.getElementById('import-results')?.scrollIntoView({behavior: 'smooth', block: 'start'});
{% endif %}

const progress = document.getElementById('import-progress');
if (progress) {
    const progressBar = progress.querySelector('.progress-bar');
    const progressTrack = progress.querySelector('.progress');
    const status = progress.querySelector('[data-progress-status]');
    const error = progress.querySelector('[data-progress-error]');
    const cancelButton = progress.querySelector('[data-cancel-import]');
    let offset = Number(progress.dataset.offset || 0);
    let total = Number(progress.dataset.total || 0);
    let cancelled = false;
    let activeBatch = null;
    let pendingBatchTimer = null;

    cancelButton.addEventListener('click', async () => {
        if (cancelled) return;
        cancelled = true;
        cancelButton.disabled = true;
        if (pendingBatchTimer !== null) {
            window.clearTimeout(pendingBatchTimer);
            pendingBatchTimer = null;
        }
        status.textContent = '{{ __('Cancelling after the current batch...', 'glpiinject')|e('js') }}';
        try {
            if (activeBatch !== null) await activeBatch;
            const body = new URLSearchParams({
                action: 'cancel',
                run_id: progress.dataset.runId,
                _glpi_csrf_token: progress.dataset.csrfToken,
            });
            const response = await fetch(progress.dataset.batchUrl, {
                method: 'POST',
                headers: {'Content-Type': 'application/x-www-form-urlencoded'},
                body,
                credentials: 'same-origin',
            });
            const responseText = await response.text();
            let result;
            try {
                result = JSON.parse(responseText);
            } catch (_) {
                const preview = responseText.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 240);
                throw new Error(`{{ __('Batch request returned non-JSON response.', 'glpiinject')|e('js') }} HTTP ${response.status}: ${preview || response.statusText}`);
            }
            if (typeof result.csrf_token === 'string' && result.csrf_token !== '') {
                progress.dataset.csrfToken = result.csrf_token;
            }
            if (!response.ok) throw new Error(result.error || '{{ __('Unable to cancel the import.', 'glpiinject')|e('js') }}');
            offset = result.processed;
            const percent = total ? Math.min(100, Math.round((offset / total) * 100)) : 100;
            progressBar.style.width = `${percent}%`;
            progressBar.textContent = `${percent}%`;
            progressTrack.setAttribute('aria-valuenow', String(percent));
            progressBar.classList.remove('progress-bar-animated', 'progress-bar-striped');
            status.textContent = '{{ __('Import cancelled after the current batch.', 'glpiinject')|e('js') }}';
            error.classList.add('d-none');
            progress.dataset.cancelled = 'true';
        } catch (exception) {
            cancelled = false;
            cancelButton.disabled = false;
            error.textContent = exception.message;
            error.classList.remove('d-none');
        }
    });

    const processBatch = async () => {
        if (cancelled) return;
        const body = new URLSearchParams({
            run_id: progress.dataset.runId,
            offset: String(offset),
            batch_size: '10',
            _glpi_csrf_token: progress.dataset.csrfToken,
        });
        try {
            const response = await fetch(progress.dataset.batchUrl, {
                method: 'POST',
                headers: {'Content-Type': 'application/x-www-form-urlencoded'},
                body,
                credentials: 'same-origin',
            });
            const responseText = await response.text();
            let result;
            try {
                result = JSON.parse(responseText);
            } catch (_) {
                const preview = responseText.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 240);
                throw new Error(`{{ __('Batch request returned non-JSON response.', 'glpiinject')|e('js') }} HTTP ${response.status}: ${preview || response.statusText}`);
            }
            if (typeof result.csrf_token === 'string' && result.csrf_token !== '') {
                progress.dataset.csrfToken = result.csrf_token;
            }
            if (!response.ok) {
                throw new Error(result.error || '{{ __('The import batch failed.', 'glpiinject')|e('js') }}');
            }
            offset = result.offset;
            total = Number(result.total || 0);
            if (cancelled) return;
            if (result.cancelled) {
                cancelled = true;
                cancelButton.disabled = true;
                status.textContent = '{{ __('Import cancelled.', 'glpiinject')|e('js') }}';
                progress.dataset.cancelled = 'true';
                return;
            }
            const percent = result.done ? 100 : (result.total ? Math.min(100, Number(result.progress || 0)) : 30);
            progressBar.style.width = `${percent}%`;
            progressBar.textContent = result.done ? '100%' : (result.total ? `${percent}%` : '');
            progressBar.classList.toggle('progress-bar-indeterminate', !result.done && !result.total);
            progressTrack.setAttribute('aria-valuenow', String(percent));
            status.textContent = result.total
                ? `{{ __('Injection of the file', 'glpiinject')|e('js') }}: ${result.processed} / ${result.total} {{ __('lines', 'glpiinject')|e('js') }}`
                : `{{ __('Processed rows', 'glpiinject')|e('js') }}: ${result.processed}`;
            if (result.done) {
                progressBar.classList.remove('progress-bar-animated');
                window.location.assign(progress.dataset.resultsUrl);
                return;
            }
            pendingBatchTimer = window.setTimeout(() => {
                pendingBatchTimer = null;
                activeBatch = processBatch();
            }, 80);
        } catch (exception) {
            error.textContent = exception.message;
            error.classList.remove('d-none');
            progressBar.classList.remove('progress-bar-animated');
        }
    };

    if (!total || offset < total) {
        activeBatch = processBatch();
    }
}
</script>